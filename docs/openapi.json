                "type": "null"
              }
            ],
            "title": "Participation Status"
          },
          "can_cancel": {
            "type": "boolean",
            "title": "Can Cancel",
            "default": false
          },
          "expected_progress": {
            "type": "number",
            "title": "Expected Progress",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "title",
          "description",
          "format",
          "duration_hours",
          "next_session",
          "action",
          "gains",
          "can_complete",
          "record_id"
        ],
        "title": "ActivityOption"
      },
